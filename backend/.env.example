# Copy to backend/.env or repo-root .env (gitignored). Loaded on server start.
# Never commit real secrets. Values below are empty placeholders only.

# --- HTTP API ---
HTTP_ADDR=:8080

# --- Binance market extras ---
# Required for spot delist schedule (hourly refresh + Delist tags in Markets).
BINANCE_API_KEY=
# DELIST_REFRESH_EVERY=1h
# DELIST_REFRESH_ON_STARTUP=true

# Shared secret for tenant APIs + /mcp (watchlist, alerts, portfolio, scanner, AI).
# Leave empty for open local/dev only. Market GETs (/api/v1/market/*) stay public.
# Clients send: Authorization: Bearer <token>  OR  X-API-Key: <token>
# Users can also create named swy_… keys (read|trade) via POST /api/v1/account/api-keys.
# API_AUTH_TOKEN=

# Mount streamable MCP at /mcp (default true). Disable if you do not need the agent surface.
# MCP_ENABLED=true

# Durable watchlist SQLite path (created on first write; survives restarts)
# WATCHLIST_DB_PATH=data/watchlist.db

# Price alerts (SQLite + background checker + webhook outbox)
# ALERTS_DB_PATH=data/alerts.db
# ALERT_CHECK_INTERVAL=30s
# WEBHOOK_DELIVERY_INTERVAL=5s
# WEBHOOK_HTTP_TIMEOUT=10s
# WEBHOOK_MAX_ATTEMPTS=8
# Allow loopback/RFC1918 webhook targets (default false — SSRF protection). Local tests only.
# WEBHOOK_ALLOW_PRIVATE=false

# Paper trading portfolio SQLite path + pending-order filler cadence
# PORTFOLIO_DB_PATH=data/portfolio.db
# PORTFOLIO_ORDER_CHECK_INTERVAL=15s

# Technical indicator scanner (watchlist rules + match history)
# SCANNER_DB_PATH=data/scanner.db
# SCANNER_CHECK_INTERVAL=60s

# Recurring buys + margin interest workers
# RECURRING_BUY_INTERVAL=30s
# MARGIN_INTEREST_INTERVAL=1m
# PORTFOLIO_SNAPSHOT_INTERVAL=15m
# PORTFOLIO_SNAPSHOT_RETENTION=2400h

# Cross-exchange price difference watches
# PRICE_DIFF_DB_PATH=data/pricediff.db
# PRICE_DIFF_CHECK_INTERVAL=30s

# User data export / import + account close
# EXPORT_DB_PATH=data/export.db
# EXPORT_FILE_DIR=data/exports
# IMPORT_DB_PATH=data/import.db
# IMPORT_FILE_DIR=data/imports
# ACCOUNT_DB_PATH=data/accounts.db

# --- CORS (production: set exact origins, not *) ---
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ALLOW_ORIGINS=*

# --- Telegram bot (optional; leave empty to disable) ---
# From @BotFather: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
# Required for private bot: your chat id (or TELEGRAM_ALLOWED_CHAT_IDS).
# Without an allowlist the bot will NOT start unless TELEGRAM_ALLOW_ALL=true.
TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_CHAT_IDS=123,456
# TELEGRAM_ALLOW_ALL=false
BOT_DEFAULT_EXCHANGE=binance
BOT_POLL_TIMEOUT=30s
BOT_LOWMCAP_LIMIT=10

# --- MCP (integrated in cmd/server at /mcp — no second process) ---
# Optional: only for stdio cmd/mcp clients that call the API over HTTP.
SWYNGORA_API_URL=http://localhost:8080

# --- AI assistant (ai/ package; also readable from repo-root .env) ---
# Provider: ollama (local default) | grok (xAI cloud). Only these two are supported.
AI_LLM_PROVIDER=ollama

# Ollama (local) — no API key. Install models via: ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Grok (xAI) — required when AI_LLM_PROVIDER=grok
# Create a key at https://console.x.ai/
XAI_API_KEY=
GROK_MODEL=grok-3-mini

# Optional AI tuning
# AI_MAX_ITERATIONS=8
# AI_TEMPERATURE=0.2
# AI_DEFAULT_CLIENT_ID=ai-assistant

# Optional: spawn Go MCP via stdio from Python (usually leave empty; HTTP tools are enough)
# SWYNGORA_MCP_COMMAND=go run ./cmd/mcp
# SWYNGORA_MCP_CWD=backend

# --- AI multi-agent (Telegram /ask, POST /api/v1/ai/chat) ---
# Python service URL (auto-start can launch it as a child of cmd/server).
AI_SERVICE_URL=http://127.0.0.1:8090
AI_TIMEOUT=300s
# Auto-start Python AI with the backend (recommended for Telegram /ask):
AI_AUTOSTART=true
# Absolute path to venv python that has swyngora-ai installed, e.g.:
# AI_PYTHON=/Users/you/swyngora/ai/.venv/bin/python
AI_PYTHON=
# Directory containing the ai package (relative to process cwd or absolute)
AI_WORKDIR=../ai
AI_LISTEN_HOST=127.0.0.1
AI_LISTEN_PORT=8090
