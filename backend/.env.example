# Copy to backend/.env or repo-root .env (gitignored). Loaded on server start.

# --- HTTP API ---
HTTP_ADDR=:8080

# --- CORS (production: set exact origins, not *) ---
# CORS_ALLOW_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ALLOW_ORIGINS=*

# --- Telegram bot (optional; leave empty to disable) ---
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Required for private bot: your chat id (or TELEGRAM_ALLOWED_CHAT_IDS).
# Without an allowlist the bot will NOT start unless TELEGRAM_ALLOW_ALL=true.
TELEGRAM_CHAT_ID=
# TELEGRAM_ALLOWED_CHAT_IDS=123,456
# TELEGRAM_ALLOW_ALL=false
BOT_DEFAULT_EXCHANGE=binance
BOT_POLL_TIMEOUT=30s
BOT_LOWMCAP_LIMIT=10
