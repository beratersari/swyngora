# API origin for the browser.
#
# Recommended for local/WSL (default): leave EMPTY so the app calls same origin
# and Vite proxies /api + /health to the Go backend.
#   VITE_API_BASE_URL=
#
# Direct to API (only if browser and backend share that host):
#   VITE_API_BASE_URL=http://127.0.0.1:8080
#   From Windows browser to WSL backend, use the WSL IP, NOT localhost:
#   VITE_API_BASE_URL=http://172.x.x.x:8080
#
VITE_API_BASE_URL=

# Dev-server only: where Vite proxies /api and /health (runs inside WSL/Linux).
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8080

# Optional fixed watchlist client id (otherwise a UUID is stored in localStorage).
# VITE_CLIENT_ID=

# When backend API_AUTH_TOKEN is set, inject it from the Vite process env (not the browser):
#   export API_AUTH_TOKEN=dev-secret
# or:
#   export VITE_DEV_API_AUTH_TOKEN=dev-secret
# Do not put production secrets in VITE_* vars that ship to the client.
