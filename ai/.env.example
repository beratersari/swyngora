# Copy to ai/.env (gitignored). Never commit real secrets.

# Backend API the market tools call
SWYNGORA_API_URL=http://localhost:8080

# LLM provider: ollama | grok  (AGENTS.md — only these two)
AI_LLM_PROVIDER=ollama

# --- Ollama (local; no key) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5

# --- Grok / xAI (required when AI_LLM_PROVIDER=grok) ---
# https://console.x.ai/
# Also used as the Ollama fallback after primary retries fail.
XAI_API_KEY=
GROK_MODEL=grok-4.3
# Grok only: none | low | medium | high
GROK_REASONING_EFFORT=low

# Optional tuning
AI_MAX_ITERATIONS=8
AI_TEMPERATURE=0.2
AI_DEFAULT_CLIENT_ID=ai-assistant
# Shared secret with the Go proxy (empty = open localhost).
# AI_SERVICE_TOKEN=
# Durable FinMem SQLite (empty = RAM only).
# AI_MEMORY_PATH=data/ai-memory.db

# Optional MCP stdio bridge (empty = use HTTP tools only)
# SWYNGORA_MCP_COMMAND=go run ./cmd/mcp
# SWYNGORA_MCP_CWD=../backend

# Optional LangSmith (your account): https://smith.langchain.com
# Copy these lines into ai/.env and set LANGSMITH_API_KEY.
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=Swyngora
LANGSMITH_API_KEY=
# Endpoint must match the LangSmith org region in Settings (URL bar), not where you live.
#   US (default, smith.langchain.com): omit, or https://api.smith.langchain.com
#   India / APAC (apac.smith.langchain.com): https://apac.api.smith.langchain.com
#   EU (eu.smith.langchain.com): https://eu.api.smith.langchain.com
#   AWS US (aws.smith.langchain.com): https://aws.api.smith.langchain.com
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
